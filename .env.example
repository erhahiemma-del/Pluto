# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RESEND_API_KEY: Required for email sending.
# Users configure this via the Secrets panel in the AI Studio UI.
RESEND_API_KEY="MY_RESEND_API_KEY"
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: server-side only. Never expose the service role key to the browser.
# Find them in Supabase → Project Settings → API.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
# Optional: table name (default extra_mile_cards). Create it with supabase/schema.sql.
SUPABASE_CARDS_TABLE="extra_mile_cards"

# ADMIN_TOKEN: access code for the campaign dashboard at /#admin. Use a long random string.
ADMIN_TOKEN="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
